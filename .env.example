# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# Get Gemini key: https://aistudio.google.com  (free tier: 1M tokens/day)
GOOGLE_API_KEY=your_gemini_key_here

# Get Groq key: https://console.groq.com  (free tier: 14400 req/day)
GROQ_API_KEY=your_groq_key_here

# ── Model Names ────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# ── Retrieval ──────────────────────────────────────────────────────────────────
TOP_K=4          # number of chunks returned per query
USE_MMR=false    # Maximal Marginal Relevance (more diverse, slightly lower hit rate)

# ── Chunking (change these for Phase 8 experiments) ───────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150
STRUCTURE_AWARE=true   # false = plain fixed-size splits (experiment baseline)

# ── Feature Flags (can be toggled off for ablation studies) ───────────────────
USE_GRADER=true          # grade retrieved chunks before generating
USE_OUTPUT_CHECK=true    # verify answer is grounded in context

# ── LLM Gateway ───────────────────────────────────────────────────────────────
LLM_TIMEOUT=25           # seconds per LLM call attempt
FORCE_PRIMARY_FAIL=false # true = always use Groq (simulates Gemini outage)

# ── Phase 8: Fast Helper Model (optional) ─────────────────────────────────────
# Uncomment to use a small fast model for router/grader/rewriter calls.
# FAST_MODEL=llama-3.1-8b-instant
